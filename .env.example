# Copy this file to .env.local (which git ignores) and fill in the values from
# Supabase dashboard → Project Settings → API Keys / Data API.
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
# The "publishable" key (sb_publishable_…) or, on older projects, the "anon" key. Never the secret/service_role key.
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...

